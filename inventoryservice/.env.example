# Copy this file to .env only when you want to override the safe local defaults.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ticketing
MYSQL_USER=ticketuser
MYSQL_PASSWORD=password
MYSQL_PORT=3306

# Use these when starting the Spring Boot application from your IDE or shell.
DB_URL=jdbc:mysql://localhost:3306/ticketing
DB_USERNAME=ticketuser
DB_PASSWORD=password
SERVER_PORT=8080
LOG_LEVEL_ROOT=INFO
